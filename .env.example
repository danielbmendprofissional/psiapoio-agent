# Copie para .env (não versionado). Qualquer provedor compatível com a API de chat da OpenAI.

# Ollama local (padrão)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:4b
# Desliga o "raciocínio" do Qwen para ficar rápido. Ajuste conforme o provedor.
LLM_EXTRA_BODY={"reasoning_effort": "none"}

# OmniRoute: LLM_BASE_URL=<url do seu OmniRoute>/v1, LLM_API_KEY=<chave>, LLM_MODEL=<combo gratuito>

# Chave compartilhada com a API .NET (cabeçalho X-Api-Key). Vazia = sem checagem (só em dev).
AGENT_API_KEY=

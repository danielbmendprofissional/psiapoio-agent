# Copie para .env (não versionado). Qualquer provedor compatível com a API de chat da OpenAI.
#
# ESCOLHA UM PROVEDOR: deixe ativo só o bloco da opção escolhida (as outras ficam comentadas).

# --- Opção A: modelo local com Ollama (padrão; precisa de `ollama pull qwen3.5:9b`) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
# Desliga o "raciocínio" do Qwen para ficar rápido. Só vale para o Qwen no Ollama.
LLM_EXTRA_BODY={"reasoning_effort": "none"}

# --- Opção B: chave de API (OpenAI, OmniRoute, Gemini no modo OpenAI, etc.) ---
# Para usar: comente TODAS as linhas da Opção A e descomente estas, preenchendo a chave.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=<sua chave de API>
# LLM_MODEL=<nome do modelo, ex.: gpt-4o-mini>
# LLM_EXTRA_BODY={}
# Outros provedores: troque só a URL (OmniRoute: <url do seu OmniRoute>/v1; Gemini: https://generativelanguage.googleapis.com/v1beta/openai).

# Chave compartilhada com a API .NET (cabeçalho X-Api-Key). Vazia = sem checagem (só em dev).
# Para rodar com a API, use o mesmo valor do user-secret Agent:ApiKey (ex.: minha-chave-dev).
AGENT_API_KEY=
